rules_version = '2';

// See PLAN.md §7. Anonymous auth exists solely to stop scripted access by
// anyone who reads the Firebase config out of the JS bundle — all signed-in
// users share full read/write access, and there is no per-user data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isISODate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isCategory(value) {
      return value in [
        'beef', 'lamb', 'pork', 'chicken', 'egg', 'fish', 'seafood', 'veggie',
        'pasta', 'rice', 'noodles', 'bread', 'potato'
      ];
    }

    function isValidCategory(category) {
      return category is map
        && isCategory(category.main)
        && (!('secondary' in category)
          || (isCategory(category.secondary) && category.secondary != category.main));
    }

    function isUnit(value) {
      return value in [
        'g', 'kg', 'ml', 'L', 'tsp', 'tbsp', 'cup',
        'each', 'clove', 'bunch', 'sprig', 'can', 'packet', 'slice', 'some'
      ];
    }

    function isAisle(value) {
      return value in [
        'produce', 'meat', 'dairy', 'bakery', 'pantry', 'frozen', 'drinks',
        'household', 'other'
      ];
    }

    // meals/{mealId}
    match /meals/{mealId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'servings', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.servings is number
        && request.resource.data.servings > 0
        && (!('category' in request.resource.data) || isValidCategory(request.resource.data.category))
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool)
        && request.resource.data.createdAt is timestamp;
      // Meals are never hard-deleted; they are archived instead.
      allow delete: if false;
    }

    // cooks/{cookId}
    match /cooks/{cookId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['mealId', 'date', 'kind', 'order', 'createdAt'])
        && request.resource.data.mealId is string
        && isISODate(request.resource.data.date)
        && request.resource.data.kind in ['cook', 'leftovers']
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && (!('fromCookId' in request.resource.data) || request.resource.data.fromCookId is string)
        && request.resource.data.createdAt is timestamp;
      allow delete: if isSignedIn();
    }

    // weeks/{saturdayISO}
    match /weeks/{saturdayISO} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['shopDate'])
        && isISODate(request.resource.data.shopDate);
      allow delete: if false;
    }

    // ingredients/{ingredientId}
    match /ingredients/{ingredientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!('aisle' in request.resource.data) || isAisle(request.resource.data.aisle))
        && (!('defaultUnit' in request.resource.data) || isUnit(request.resource.data.defaultUnit))
        && request.resource.data.createdAt is timestamp;
      // Ingredients are never deleted and never archived: a recipe may
      // reference any of them, and an unused one costs nothing.
      allow delete: if false;
    }

    // recipes/{mealId}
    match /recipes/{mealId} {
      allow read: if isSignedIn();
      // Rules cannot iterate a list's contents, so `items` is checked for
      // type and size only; the shape of each item is the frontend's to
      // hold. See PLAN.md §7.
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200
        && request.resource.data.updatedAt is timestamp;
      // A recipe emptied of ingredients keeps an empty `items`; the document
      // is not deleted, so the shopping list can name the meal as having
      // none.
      allow delete: if false;
    }
  }
}
